{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Volt",
  "version": "0.2.1",
  "identifier": "com.volt.apicoder",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Volt",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Volt",
    "copyright": "© 2025 Volt",
    "category": "DeveloperTool",
    "shortDescription": "A fast, project-aware AI coding agent",
    "longDescription": "Volt is a blazingly fast AI coding agent built with Rust. Chat with an AI that can read, edit and run your project — supporting OpenAI, Anthropic, Gemini and any OpenAI-compatible endpoint.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Thai"],
        "displayLanguageSelector": true,
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "startMenuFolder": "Volt",
        "customLanguageFiles": {
          "Thai": "installer/thai.nsh"
        }
      }
    }
  }
}
